# Generated by AWS Solution Builder — private-only profile.
#
# What this will and will not do:
#   · every subnet is private. No internet gateway, no NAT gateway, no public IP addresses.
#   · load balancers are internal, or an existing one is reused and only a listener rule is added.
#   · TLS uses self-signed certificates imported into ACM. Importing is free.
#   · the only endpoint created by default is the S3 gateway endpoint, which is also free.
#
# Review every line before running.

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# =====================================================================
# Network: web-vpc
# =====================================================================

resource "aws_vpc" "web_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = { Name = "web-vpc" }
}

# One route table with no default route. Nothing here can reach the internet.
resource "aws_route_table" "web_vpc_private" {
  vpc_id = aws_vpc.web_vpc.id
  tags   = { Name = "web-vpc-private-rt" }
}

# Gateway endpoint. No hourly charge, no data charge.
# This is what lets dnf and yum reach the Amazon Linux repositories, which live in S3.
resource "aws_vpc_endpoint" "web_vpc_s3" {
  vpc_id            = aws_vpc.web_vpc.id
  service_name      = "com.amazonaws.us-east-1.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = [aws_route_table.web_vpc_private.id]
  tags              = { Name = "web-vpc-s3" }
}

resource "aws_subnet" "web_private_a" {
  vpc_id                  = aws_vpc.web_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = false
  tags = {
    Name = "web-private-a"
    Tier = "application"
  }
}

resource "aws_route_table_association" "web_private_a_assoc" {
  subnet_id      = aws_subnet.web_private_a.id
  route_table_id = aws_route_table.web_vpc_private.id
}

resource "aws_subnet" "web_private_b" {
  vpc_id                  = aws_vpc.web_vpc.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = false
  tags = {
    Name = "web-private-b"
    Tier = "application"
  }
}

resource "aws_route_table_association" "web_private_b_assoc" {
  subnet_id      = aws_subnet.web_private_b.id
  route_table_id = aws_route_table.web_vpc_private.id
}

resource "aws_security_group" "web_app_sg" {
  name        = "web-app-sg"
  description = "App tier, reachable from the load balancer only"
  vpc_id      = aws_vpc.web_vpc.id

  ingress {
    description     = "allow tcp 443 from 10.0.0.0/16"
    from_port       = 443
    to_port         = 443
    protocol        = "tcp"
    cidr_blocks     = ["10.0.0.0/16"]
  }

  egress {
    description = "outbound stays inside the VPC; there is no internet route"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "web-app-sg" }
}

resource "aws_launch_template" "web_lt" {
  name          = "web-lt"
  image_id      = "ami-0c02fb55956c7d316"
  instance_type = "t3.micro"
  vpc_security_group_ids = [aws_security_group.web_app_sg.id]

  iam_instance_profile {
    name = "ssm-instance-profile"
  }

  block_device_mappings {
    device_name = "/dev/xvda"

    ebs {
      volume_size = 10
      volume_type = "gp3"
      encrypted   = true
    }
  }

  metadata_options {
    http_tokens                 = "required"
    http_endpoint               = "enabled"
    http_put_response_hop_limit = 2
  }

  user_data = base64encode(<<-USERDATA
    #!/bin/bash
    set -euxo pipefail
    # Amazon Linux repositories live in S3, so this works over the free gateway endpoint
    # with no internet access at all.
    dnf -y install httpd mod_ssl
    
    # Self-signed certificate for the leg between the load balancer and this instance.
    # The load balancer does not verify it, so a plain self-signed certificate is enough.
    HOST=$(hostname -f)
    openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 825 \
      -keyout /etc/pki/tls/private/localhost.key \
      -out /etc/pki/tls/certs/localhost.crt \
      -subj "/CN=$HOST/O=Internal" \
      -addext "subjectAltName=DNS:$HOST"
    chmod 600 /etc/pki/tls/private/localhost.key
    
    echo ok > /var/www/html/health
    cat > /var/www/html/index.html <<HTML
    <!doctype html><meta charset="utf-8"><title>Internal site</title>
    <body style="font-family:sans-serif;padding:3rem">
    <h1>It works</h1><p>Served privately by $HOST</p>
    </body>
    HTML
    
    systemctl enable --now httpd
    
  USERDATA
  )

  tag_specifications {
    resource_type = "instance"
    tags          = { Name = "web-lt" }
  }
}

resource "aws_lb_target_group" "web_tg" {
  name                 = "web-tg"
  port                 = 80
  protocol             = "HTTP"
  target_type          = "instance"
  vpc_id               = aws_vpc.web_vpc.id
  deregistration_delay = 30

  health_check {
    path                = "/"
    protocol            = "HTTPS"
    matcher             = "200"
    interval            = 30
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
  }

  tags = { Name = "web-tg" }
}

resource "aws_lb_target_group_attachment" "web_tg_web_1" {
  target_group_arn = aws_lb_target_group.web_tg.arn
  target_id        = aws_instance.web_1.id
  port             = 443
}

resource "aws_lb_target_group_attachment" "web_tg_web_2" {
  target_group_arn = aws_lb_target_group.web_tg.arn
  target_id        = aws_instance.web_2.id
  port             = 443
}

# =====================================================================
# web-alb: reuses the existing load balancer "shared-internal-alb".
# Nothing below creates or destroys that load balancer. Terraform only
# adds one listener rule, which carries no charge of its own, and the
# certificate already on the listener is reused as is.
# =====================================================================

data "aws_lb" "web_alb" {
  name = "shared-internal-alb"
}

data "aws_lb_listener" "web_alb" {
  load_balancer_arn = data.aws_lb.web_alb.arn
  port              = 80
}

resource "aws_lb_listener_rule" "web_alb" {
  listener_arn = data.aws_lb_listener.web_alb.arn
  priority     = 100

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web_tg.arn
  }

  condition {
    host_header {
      values = ["web.internal"]
    }
  }

  condition {
    path_pattern {
      values = ["/*"]
    }
  }

  tags = { Name = "web-alb" }
}

# Let whichever security groups that load balancer already uses reach the instances.
resource "aws_vpc_security_group_ingress_rule" "web_app_sg_from_web_alb" {
  for_each = toset(data.aws_lb.web_alb.security_groups)

  security_group_id            = aws_security_group.web_app_sg.id
  referenced_security_group_id = each.value
  ip_protocol                  = "tcp"
  from_port                    = 443
  to_port                      = 443
  description                  = "from shared-internal-alb"
}

output "web_alb_dns_name" {
  description = "Private name of the shared load balancer. Resolvable inside the VPC only."
  value       = data.aws_lb.web_alb.dns_name
}

resource "aws_instance" "web_1" {
  launch_template {
    id      = aws_launch_template.web_lt.id
    version = "$Latest"
  }
  subnet_id                   = aws_subnet.web_private_a.id
  associate_public_ip_address = false

  tags = { Name = "web-1" }
}

resource "aws_instance" "web_2" {
  launch_template {
    id      = aws_launch_template.web_lt.id
    version = "$Latest"
  }
  subnet_id                   = aws_subnet.web_private_b.id
  associate_public_ip_address = false

  tags = { Name = "web-2" }
}

