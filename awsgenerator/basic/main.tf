# Generated by AWS Solution Builder
# Review every line before running. This is a starting point, not a finished product.

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_vpc" "web_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = { Name = "web-vpc" }
}

resource "aws_internet_gateway" "web_vpc_igw" {
  vpc_id = aws_vpc.web_vpc.id
  tags   = { Name = "web-vpc-igw" }
}

resource "aws_route_table" "web_vpc_public" {
  vpc_id = aws_vpc.web_vpc.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.web_vpc_igw.id
  }
  tags = { Name = "web-vpc-public-rt" }
}

resource "aws_subnet" "web_public_a" {
  vpc_id                  = aws_vpc.web_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true
  tags = { Name = "web-public-a" }
}

resource "aws_route_table_association" "web_public_a_assoc" {
  subnet_id      = aws_subnet.web_public_a.id
  route_table_id = aws_route_table.web_vpc_public.id
}

resource "aws_subnet" "web_public_b" {
  vpc_id                  = aws_vpc.web_vpc.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = true
  tags = { Name = "web-public-b" }
}

resource "aws_route_table_association" "web_public_b_assoc" {
  subnet_id      = aws_subnet.web_public_b.id
  route_table_id = aws_route_table.web_vpc_public.id
}

resource "aws_security_group" "web_alb_sg" {
  name        = "web-alb-sg"
  description = "Public entry point"
  vpc_id      = aws_vpc.web_vpc.id

  ingress {
    description     = "allow tcp 443 from 0.0.0.0/0"
    from_port       = 443
    to_port         = 443
    protocol        = "tcp"
    cidr_blocks     = ["0.0.0.0/0"]
  }

  ingress {
    description     = "allow tcp 80 from 0.0.0.0/0"
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    cidr_blocks     = ["0.0.0.0/0"]
  }

  egress {
    description = "allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "web-alb-sg" }
}

resource "aws_security_group" "web_app_sg" {
  name        = "web-app-sg"
  description = "App tier"
  vpc_id      = aws_vpc.web_vpc.id

  ingress {
    description     = "allow tcp 80 from web-alb-sg"
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.web_alb_sg.id]
  }

  egress {
    description = "allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "web-app-sg" }
}

resource "aws_launch_template" "web_lt" {
  name          = "web-lt"
  image_id      = "ami-0c02fb55956c7d316"
  instance_type = "t3.micro"
  vpc_security_group_ids = [aws_security_group.web_app_sg.id]

  block_device_mappings {
    device_name = "/dev/xvda"
    ebs {
      volume_size = 10
      volume_type = "gp3"
      encrypted   = true
    }
  }

  metadata_options {
    http_tokens                 = "required"
    http_endpoint               = "enabled"
    http_put_response_hop_limit = 2
  }

  user_data = base64encode(<<-USERDATA
    #!/bin/bash
    set -euxo pipefail
    dnf -y update
    dnf -y install httpd
    systemctl enable --now httpd
    TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    HOST=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-hostname)
    cat > /var/www/html/index.html <<HTML
    <!doctype html><meta charset="utf-8"><title>Hello</title>
    <body style="font-family:sans-serif;padding:3rem">
    <h1>It works</h1><p>Served by $HOST</p>
    </body>
    HTML
    # health check endpoint that never needs a login
    echo ok > /var/www/html/health
    
  USERDATA
  )

  tag_specifications {
    resource_type = "instance"
    tags          = { Name = "web-lt" }
  }
}

resource "aws_lb_target_group" "web_tg" {
  name        = "web-tg"
  port        = 80
  protocol    = "HTTP"
  target_type = "instance"
  vpc_id      = aws_vpc.web_vpc.id
  deregistration_delay = 30

  health_check {
    path                = "/health"
    matcher             = "200"
    interval            = 30
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
  }

  tags = { Name = "web-tg" }
}

resource "aws_lb_target_group_attachment" "web_tg_web_1" {
  target_group_arn = aws_lb_target_group.web_tg.arn
  target_id        = aws_instance.web_1.id
  port             = 80
}

resource "aws_lb_target_group_attachment" "web_tg_web_2" {
  target_group_arn = aws_lb_target_group.web_tg.arn
  target_id        = aws_instance.web_2.id
  port             = 80
}

resource "aws_lb" "web_alb" {
  name               = "web-alb"
  load_balancer_type = "application"
  internal           = false
  subnets            = [aws_subnet.web_public_a.id, aws_subnet.web_public_b.id]
  security_groups    = [aws_security_group.web_alb_sg.id]
  idle_timeout       = 60
  tags               = { Name = "web-alb" }
}

resource "aws_lb_listener" "web_alb_main" {
  load_balancer_arn = aws_lb.web_alb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  #certificate_arn   = "REPLACE_ME"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web_tg.arn
  }
}

resource "aws_lb_listener" "web_alb_redirect" {
  load_balancer_arn = aws_lb.web_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

output "web_alb_dns_name" {
  description = "Point your domain at this address"
  value       = aws_lb.web_alb.dns_name
}

resource "aws_instance" "web_1" {
  launch_template {
    id      = aws_launch_template.web_lt.id
    version = "$Latest"
  }
  subnet_id                   = aws_subnet.web_public_a.id
  associate_public_ip_address = false
  tags                        = { Name = "web-1" }
}

resource "aws_instance" "web_2" {
  launch_template {
    id      = aws_launch_template.web_lt.id
    version = "$Latest"
  }
  subnet_id                   = aws_subnet.web_public_b.id
  associate_public_ip_address = false
  tags                        = { Name = "web-2" }
}

