terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_vpc" "keycloak_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = { Name = "keycloak-vpc" }
}

resource "aws_internet_gateway" "keycloak_vpc_igw" {
  vpc_id = aws_vpc.keycloak_vpc.id
  tags   = { Name = "keycloak-vpc-igw" }
}

resource "aws_route_table" "keycloak_vpc_public" {
  vpc_id = aws_vpc.keycloak_vpc.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.keycloak_vpc_igw.id
  }
  tags = { Name = "keycloak-vpc-public-rt" }
}

resource "aws_subnet" "keycloak_public_a" {
  vpc_id                  = aws_vpc.keycloak_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true
  tags = { Name = "keycloak-public-a" }
}

resource "aws_route_table_association" "keycloak_public_a_assoc" {
  subnet_id      = aws_subnet.keycloak_public_a.id
  route_table_id = aws_route_table.keycloak_vpc_public.id
}

resource "aws_subnet" "keycloak_public_b" {
  vpc_id                  = aws_vpc.keycloak_vpc.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = true
  tags = { Name = "keycloak-public-b" }
}

resource "aws_route_table_association" "keycloak_public_b_assoc" {
  subnet_id      = aws_subnet.keycloak_public_b.id
  route_table_id = aws_route_table.keycloak_vpc_public.id
}

resource "aws_security_group" "keycloak_alb_sg" {
  name        = "keycloak-alb-sg"
  description = "Public entry point"
  vpc_id      = aws_vpc.keycloak_vpc.id

  ingress {
    description     = "allow tcp 443 from 0.0.0.0/0"
    from_port       = 443
    to_port         = 443
    protocol        = "tcp"
    cidr_blocks     = ["0.0.0.0/0"]
  }

  ingress {
    description     = "allow tcp 80 from 0.0.0.0/0"
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    cidr_blocks     = ["0.0.0.0/0"]
  }

  egress {
    description = "allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "keycloak-alb-sg" }
}

resource "aws_security_group" "keycloak_app_sg" {
  name        = "keycloak-app-sg"
  description = "App tier"
  vpc_id      = aws_vpc.keycloak_vpc.id

  ingress {
    description     = "allow tcp 8080 from keycloak-alb-sg"
    from_port       = 8080
    to_port         = 8080
    protocol        = "tcp"
    security_groups = [aws_security_group.keycloak_alb_sg.id]
  }

  egress {
    description = "allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "keycloak-app-sg" }
}

resource "aws_launch_template" "keycloak_lt" {
  name          = "keycloak-lt"
  image_id      = "ami-0c02fb55956c7d316"
  instance_type = "t3.medium"
  vpc_security_group_ids = [aws_security_group.keycloak_app_sg.id]

  iam_instance_profile {
    name = "keycloak-secrets-profile"
  }

  block_device_mappings {
    device_name = "/dev/xvda"
    ebs {
      volume_size = 20
      volume_type = "gp3"
      encrypted   = true
    }
  }

  metadata_options {
    http_tokens                 = "required"
    http_endpoint               = "enabled"
    http_put_response_hop_limit = 2
  }

  user_data = base64encode(<<-USERDATA
    #!/bin/bash
    set -euxo pipefail
    dnf -y update
    dnf -y install docker
    systemctl enable --now docker
    
    # Pull the admin password from Secrets Manager instead of hard-coding it.
    # The instance needs an IAM role that allows secretsmanager:GetSecretValue.
    ADMIN_PASS=$(aws secretsmanager get-secret-value --secret-id keycloak/admin --query SecretString --output text --region REGION || echo "change-me-now")
    
    docker run -d --restart unless-stopped --name keycloak -p 8080:8080 \
      -e KC_BOOTSTRAP_ADMIN_USERNAME=admin \
      -e KC_BOOTSTRAP_ADMIN_PASSWORD="$ADMIN_PASS" \
      -e KC_PROXY_HEADERS=xforwarded \
      -e KC_HTTP_ENABLED=true \
      -e KC_HOSTNAME=https://login.example.com \
      -e KC_HEALTH_ENABLED=true \
      -e KC_DB=postgres \
      -e KC_DB_URL=jdbc:postgresql://REPLACE-DB-HOST:5432/keycloak \
      -e KC_DB_USERNAME=keycloak \
      -e KC_DB_PASSWORD=REPLACE_ME \
      quay.io/keycloak/keycloak:26.0 start --optimized
    
    # Health lives on the management port 9000 in Keycloak 25+, so expose it too
    # if you point the target group at /health/ready.
    
  USERDATA
  )

  tag_specifications {
    resource_type = "instance"
    tags          = { Name = "keycloak-lt" }
  }
}

resource "aws_lb_target_group" "keycloak_tg" {
  name        = "keycloak-tg"
  port        = 8080
  protocol    = "HTTP"
  target_type = "instance"
  vpc_id      = aws_vpc.keycloak_vpc.id
  deregistration_delay = 30

  health_check {
    path                = "/health/ready"
    matcher             = "200"
    interval            = 30
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
  }

  stickiness {
    type            = "lb_cookie"
    cookie_duration = 86400
    enabled         = true
  }

  tags = { Name = "keycloak-tg" }
}

resource "aws_lb_target_group_attachment" "keycloak_tg_keycloak_1" {
  target_group_arn = aws_lb_target_group.keycloak_tg.arn
  target_id        = aws_instance.keycloak_1.id
  port             = 8080
}

resource "aws_lb_target_group_attachment" "keycloak_tg_keycloak_2" {
  target_group_arn = aws_lb_target_group.keycloak_tg.arn
  target_id        = aws_instance.keycloak_2.id
  port             = 8080
}

resource "aws_lb" "keycloak_alb" {
  name               = "keycloak-alb"
  load_balancer_type = "application"
  internal           = false
  subnets            = [aws_subnet.keycloak_public_a.id, aws_subnet.keycloak_public_b.id]
  security_groups    = [aws_security_group.keycloak_alb_sg.id]
  idle_timeout       = 60
  tags               = { Name = "keycloak-alb" }
}

resource "aws_lb_listener" "keycloak_alb_main" {
  load_balancer_arn = aws_lb.keycloak_alb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = "REPLACE_ME"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.keycloak_tg.arn
  }
}

resource "aws_lb_listener" "keycloak_alb_redirect" {
  load_balancer_arn = aws_lb.keycloak_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

output "keycloak_alb_dns_name" {
  description = "Point your domain at this address"
  value       = aws_lb.keycloak_alb.dns_name
}

resource "aws_instance" "keycloak_1" {
  launch_template {
    id      = aws_launch_template.keycloak_lt.id
    version = "$Latest"
  }
  subnet_id                   = aws_subnet.keycloak_public_a.id
  associate_public_ip_address = false
  tags                        = { Name = "keycloak-1" }
}

resource "aws_instance" "keycloak_2" {
  launch_template {
    id      = aws_launch_template.keycloak_lt.id
    version = "$Latest"
  }
  subnet_id                   = aws_subnet.keycloak_public_b.id
  associate_public_ip_address = false
  tags                        = { Name = "keycloak-2" }
}

